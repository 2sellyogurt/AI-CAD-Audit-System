# ===========================================
# AI-CAD-Audit-System v7.0 环境配置
# ===========================================
# 首次使用：复制此文件为 .env 并填入实际值
#   Windows: copy .env.template .env
#   Linux:   cp .env.template .env

# ===== Web 服务端口 =====
# Admin 管理后台端口（launcher.py 启动）
V7_ADMIN_PORT=2708

# Review UI 人工复核界面端口（master_v7.py 启动）
V7_REVIEW_PORT=8080

# ===== 项目信息 =====
# 项目名称（显示在报告封面和Web界面标题）
V7_PROJECT_NAME=施工图审查项目

# 项目编号（报告文件名后缀，默认001）
V7_PROJECT_CODE=001

# DXF 图纸输入目录
V7_INPUT_DIR=src/v7/input

# 审查报告输出目录
V7_OUTPUT_DIR=src/output_v7.0

# ===== LLM API Key（按需填写一个或多个） =====
# 智谱AI（默认Provider）
# ZHIPU_API_KEY=

# DeepSeek（备用）
# DEEPSEEK_API_KEY=

# OpenAI（复杂视觉检查）
# OPENAI_API_KEY=

# 豆包（Doubao）
# DOUBAO_API_KEY=

# Ollama 本地（默认 http://localhost:11434/v1）
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ===== Flask 配置 =====
V7_SECRET_KEY=v7-review-secret-development
FLASK_DEBUG=0

# ===== Python 编码 =====
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ===== CORS 白名单（默认仅本地访问） =====
# 多端口用逗号分隔，例如: V7_CORS_ORIGINS=http://localhost:2708,http://localhost:8080
V7_CORS_ORIGINS=http://localhost:2708,http://localhost:8080,http://127.0.0.1:2708,http://127.0.0.1:8080
